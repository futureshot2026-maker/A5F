# أكاديمية المستقبل — server environment variables
PORT=3000
SITE_URL=http://localhost:3000

# Stripe: get keys from https://dashboard.stripe.com/apikeys
# Without STRIPE_SECRET_KEY the booking form still works and saves leads,
# but falls back to a manual/WhatsApp payment flow instead of redirecting
# to Stripe Checkout.
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET
