{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "a5f-manuale",
  "main": "worker.js",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
