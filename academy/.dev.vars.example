# انسخ هذا الملف إلى .dev.vars للتجربة المحلية (لا تضعه في Git)
# وفي الإنتاج استخدم: npx wrangler secret put <NAME>

# مفتاح Stripe السري — بدونه يعمل الموقع في وضع تجريبي ويسجّل الطلب بلا دفع
STRIPE_SECRET_KEY=

# سر التحقق من الويب هوك (اختياري لكن مستحسن في الإنتاج)
STRIPE_WEBHOOK_SECRET=

# رابط اختياري يستقبل بيانات كل حجز جديد (Zapier / Make / n8n / سكربت خاص)
NOTIFY_WEBHOOK_URL=
