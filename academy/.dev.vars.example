# انسخ هذا الملف إلى .dev.vars للتجربة المحلية (لا تضعه في Git)
# وفي الإنتاج استخدم: npx wrangler secret put <NAME>

# ---- PayPal (Orders v2) ----
# أنشئ تطبيق REST من https://developer.paypal.com ثم انسخ المفتاحين
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# sandbox للتجربة، live للإنتاج
PAYPAL_ENV=sandbox
# معرّف الويب هوك (اختياري لكن مستحسن لتأكيد الدفعات تلقائيًا)
PAYPAL_WEBHOOK_ID=

# ---- سعر التحويل ----
# PayPal لا يدعم الشيكل كعملة تحصيل، لذا يُحصَّل بالدولار وفق هذا السعر
USD_RATE=3.7

# ---- بيانات التحويل البنكي (تتجاوز القيم في public/data/courses.json) ----
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NO=
BANK_IBAN=
BANK_SWIFT=
BANK_CURRENCIES=

# ---- إشعارات ----
# رابط اختياري يستقبل بيانات كل طلب جديد (Zapier / Make / n8n / سكربت خاص)
NOTIFY_WEBHOOK_URL=
